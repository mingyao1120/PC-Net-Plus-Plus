{
  "dataset": {
    "dataset": "CharadesSTA",
    "feature_path": "data/features/i3d_features.hdf5",
    "vocab_size": 1111,
    "word_dim": 300,
    "frame_dim": 1024,
    "max_num_words": 20,
    "max_num_frames": 200,
    "target_stride": 1,
    "train_data": "data/charades/train.json",
    "test_data": "data/charades/test_trivial.json",
    "val_data": "data/charades/test_trivial.json",
    "vocab_path": "data/charades/glove.pkl"
  },
  "protocol": {
    "mode": "unified_paper",
    "selection_split": "test",
    "selection_metric": "R@1,mIoU",
    "deterministic_eval_mask": true
  },
  "train": {
    "optimizer": {
      "lr": 0.0004,
      "weight_decay": 0,
      "warmup_updates": 400,
      "warmup_init_lr": 1e-07
    },
    "batch_size": 32,
    "max_num_epochs": 26,
    "model_saved_path": "outputs/charades",
    "evaluate_before_train": true,
    "early_stop_min_epoch": 9,
    "early_stop_patience": 5,
    "early_stop_min_delta": 0.0001,
    "num_workers": 4,
    "test_num_workers": 2,
    "val_num_workers": 1
  },
  "model": {
    "name": "PCNet",
    "config": {
      "frames_input_size": 1024,
      "words_input_size": 300,
      "hidden_size": 256,
      "use_negative": true,
      "num_props": 8,
      "sigma": 9.0,
      "sigma_neg": 9.0,
      "gamma": 0.5,
      "dropout": 0.1,
      "DualTransformer": {
        "d_model": 256,
        "num_heads": 4,
        "num_decoder_layers1": 3,
        "num_decoder_layers2": 3,
        "dropout": 0.1
      },
      "proposal_match_mode": "per_sample",
      "proposal_feature_downsample": 4,
      "num_iteration": 4,
      "proposal_generator_mode": "slot_hungarian",
      "proposal_width_power": 1.0,
      "proposal_fusion_mode": "center_width_learnable",
      "proposal_fusion_alpha": 0.75,
      "gaussian_mode": "fixed",
      "proposal_kernel": "gaussian",
      "peak_beta_init": 0.2,
      "peak_beta_parameterization": "direct",
      "negative_curriculum_epochs": 26,
      "deterministic_eval_mask": true
    }
  },
  "loss": {
    "margin_1": 0.15,
    "margin_2": 0.15,
    "lambda": 0.146,
    "alpha_1": 1,
    "alpha_2": 5,
    "co_cl_loss": 0.5,
    "co_qua_loss": 1.0,
    "inter_lambda": 0.1
  },
  "cpr": {
    "family": "cpr",
    "lambda": 6.0,
    "deletion_power": 3.0,
    "boundary_alpha": 0.75,
    "boundary_topk": 2,
    "boundary_temperature": 0.5,
    "boundary_min_iou": 0.1
  },
  "seed": 8
}
